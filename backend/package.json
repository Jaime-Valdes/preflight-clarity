    "test": "tsx scripts/test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@preflight/shared": "*",
    "@supabase/supabase-js": "^2.117.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
