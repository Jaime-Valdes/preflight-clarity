# Copy to .env for local development. On Railway/Render/Fly, set these as service variables.

# Port to listen on (hosts usually set this for you).
PORT=8787

# Gate for GET /responses and GET /signups (the team results page). Use the same value in the frontend.
ADMIN_KEY=dev-admin-key

# Supabase project (Project Settings → API). Use the service-role / secret key — never the anon key.
# (NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SECRET_KEY are accepted as fallbacks for the two names below.)
# When both are set, sessions are stored in the `responses` table and product-interest sign-ups
# in the `signups` table (see supabase/schema.sql).
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Development fallback when Supabase isn't configured: store sessions in a local JSON file
# (sign-ups go to a sibling signups.json). Not for real data — the files disappear on redeploy.
DATA_FILE=./data/responses.json

# Allowed browser origin for direct (non-proxied) calls. The web app proxies through
# its own origin, so "*" is fine for a prototype.
CORS_ORIGIN=*

# POST /responses rate limit per IP address (default 1000 per minute; a participant
# sends at most ~6, so this only stops floods, not a classroom behind one NAT).
# RATE_LIMIT_PER_MINUTE=1000

# Version D schedules (docs/REAL_DATA.md). FLIGHT_PROVIDER picks where GET /flights/day gets a
# route-day's nonstops: "generator" (default: the illustrative timetable, no key needed),
# "aerodatabox" (published schedules; needs the key below) or "fixture" (the saved listings in
# fixtures/aerodatabox, for tests). A day is kept 24 h (in memory, and in the `route_days` table
# with Supabase) and never past 7 days.
# FLIGHT_PROVIDER=generator

# The AeroDataBox key and where it was issued: "rapidapi" (the marketplace plans, the free one
# included; the default) or "direct" (a key from api.aerodatabox.com). The key is never logged.
# AERODATABOX_API_KEY=
# AERODATABOX_HOST=rapidapi

# Provider calls (route-days fetched from AeroDataBox) one API process may make per hour; past it a
# cached day within 7 days stands in, else the request answers 503. Default 60. The free Basic plan
# has 400 units a month and a route-day costs 4, so keep this low on a free key.
# FLIGHT_PROVIDER_ROUTE_DAYS_PER_HOUR=60
