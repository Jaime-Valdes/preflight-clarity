# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Base URL of the deployed backend (../backend). Leave unset to run the app without a backend
# (sessions are then saved only in the participant's browser).
API_URL=http://localhost:8787

# Gate for the team results page: /results?key=<ADMIN_KEY>. Use the same value as the backend.
ADMIN_KEY=dev-admin-key

# Public URL of the deployed site, used for the link-preview image. Optional on Vercel.
# NEXT_PUBLIC_SITE_URL=https://preflight-clarity.vercel.app

# PostHog product analytics (funnels, paths, session replay). Leave unset to send nothing.
# Project API key from PostHog → Project settings (starts with phc_). Public by design.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# PostHog Cloud region: https://us.posthog.com (default) or https://eu.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
